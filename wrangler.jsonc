// Réglages de publication Cloudflare : le site statique généré dans dist/.
{
  "name": "re-public",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": true,
  // Nom de domaine principal, rattaché au site (certificat HTTPS automatique).
  "routes": [{ "pattern": "republic-fr.org", "custom_domain": true }],
  // Versions d'essai des pull requests (commande « wrangler preview »).
  "previews": {},
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
